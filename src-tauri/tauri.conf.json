{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Translation",
  "version": "0.2.2",
  "identifier": "com.aura.translation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "translation",
        "title": "Aura Translation",
        "width": 392,
        "height": 188,
        "minWidth": 360,
        "minHeight": 156,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "create": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Aura Settings",
        "width": 480,
        "height": 680,
        "minWidth": 420,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
